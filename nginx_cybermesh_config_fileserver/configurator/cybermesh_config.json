{
    "server": "#SERVERIP",
    "server_port": "443",
    "pbk": "#PUBKEY",
    "uuid": "#UUID",
    "sid": "#SID",
    "sni": "#SNI",
    "fp": "chrome",
    "flow": "xtls-rprx-vision",
    "rules": [
        {
            "domain": "chatgpt.com"
        },
        {
            "domain_regex": "^(.*?)\\.openai\\.com$"
        },
        {
            "process_name": "chrome.exe"
        },
        {
            "process_name": "qtranslate.exe"
        },
        {
            "process_name": "Update.exe"
        },
        {
            "process_name": "Discord.exe"
        },
        {
            "process_name": "DeepL.exe"
        },
        {
            "process_name": "CefSharp.BrowserSubprocess.exe"
        }
  
    ],
    "ping": {
        "connect": {
            "url": "https://nginx.remotemodelstudio.com/api/proxy/ping",
            "body": {
                "token": "token",
                "uniqid": "id"
            }
        },
        "disconnect": {
            "url": "https://nginx.remotemodelstudio.com/api/proxy/disconnect",
            "body": {
                "token": "token",
                "uniqid": "id"
            }
        }
    }
}
